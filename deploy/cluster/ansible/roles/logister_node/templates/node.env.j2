{% set env = {
  'LOGISTER_NODE_ID': logister_node_id,
  'LOGISTER_API_IMAGE': logister_api_image,
  'LOGISTER_UI_IMAGE': logister_ui_image,
  'LOGISTER_BIND_ADDRESS': logister_bind_address,
  'LOGISTER_UI_PORT': logister_ui_port,
  'DATABASE_URL': logister_database_url,
  'OPENSEARCH_URL': logister_opensearch_url,
  'OPENSEARCH_INDEX': logister_opensearch_index,
  'OPENSEARCH_SHARDS': logister_opensearch_shards,
  'KAFKA_BROKERS': logister_kafka_brokers,
  'KAFKA_TOPIC': logister_kafka_topic,
  'KAFKA_GROUP': logister_kafka_group,
  'INGEST_WORKERS': logister_ingest_workers,
  'BULK_WORKERS': logister_bulk_workers,
  'BULK_MAX_BYTES': logister_bulk_max_bytes,
  'AUTH_LOCAL_PASSWORD': logister_auth_local_password,
  'AUTH_SETTINGS_KEY': logister_auth_settings_key,
  'AUTH_COOKIE_SECURE': logister_cookie_secure | bool | ternary('true', 'false'),
  'CORS_ORIGIN': logister_cors_origin
} %}
{% for key, value in env.items() %}
{{ key }}={{ value | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
{% endfor %}
