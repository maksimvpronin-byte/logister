LOGISTER_NODE_ID=node-01
LOGISTER_API_IMAGE=logister-api:local
LOGISTER_UI_IMAGE=logister-ui:local
LOGISTER_BIND_ADDRESS=127.0.0.1
LOGISTER_UI_PORT=3000

DATABASE_URL=mongodb://mongo-01.example.net:27017,mongo-02.example.net:27017,mongo-03.example.net:27017/logister?replicaSet=logister
OPENSEARCH_URL=http://search.example.net:9200
OPENSEARCH_INDEX=logs
OPENSEARCH_SHARDS=3
KAFKA_BROKERS=kafka-01.example.net:9092,kafka-02.example.net:9092,kafka-03.example.net:9092
KAFKA_TOPIC=logister-ingest
KAFKA_GROUP=logister

CORS_ORIGIN=https://logs.example.net
AUTH_COOKIE_SECURE=true
AUTH_LOCAL_PASSWORD=
AUTH_SETTINGS_KEY=
